# ──────────────────────────────────────────────────────────────────────────
# FastGram en un VPS — variables de `deploy/compose.vps.yml` (PU-RUN-004)
#
#   cp deploy/.env.vps.example deploy/.env && chmod 600 deploy/.env
#
# `deploy/.env` está ignorado por git (`.env` en `.gitignore`). NUNCA subas el
# completado: tiene la contraseña de la base, la del bucket y el token del túnel.
# Los valores de acá son ejemplos o están vacíos; los secretos se generan con
# el comando que dice cada uno.
# ──────────────────────────────────────────────────────────────────────────

# Perfiles de Compose. `minio` = bucket local en el VPS (lo normal).
# Agregá `tunnel` cuando tengas el named tunnel: COMPOSE_PROFILES=minio,tunnel
COMPOSE_PROFILES=minio

# Etiqueta de las imágenes que construye `up --build` (fastgram/api:<tag>, …).
FASTGRAM_IMAGE_TAG=local

# Zona horaria de los contenedores. La marca personal nace con esta zona
# (en la Mac se toma la de la máquina). Formato IANA, p. ej. America/Argentina/Buenos_Aires.
TZ=UTC

LOG_LEVEL=info

# ── A qué interfaz del VPS se atan los puertos publicados (web y MinIO) ───
# 127.0.0.1 (default): sólo por túnel SSH (`ssh -L`). La opción más cerrada.
# La IP de Tailscale del VPS (100.x.y.z, `tailscale ip -4`): entrás desde tus
# dispositivos del tailnet. NUNCA 0.0.0.0: la app no tiene login.
FASTGRAM_BIND=127.0.0.1
# Puerto del host para la web. Con 3000, las redirect URIs locales de OAuth
# (`http://localhost:3000/...`) siguen valiendo por el túnel SSH.
WEB_HOST_PORT=3000
# El origin con el que abrís la web en el navegador (esquema + host + puerto,
# sin barra final). El anti-CSRF compara contra esto: si no coincide, TODAS
# las escrituras responden 503. Túnel SSH: http://localhost:3000.
# Tailscale: http://<nombre-del-vps>:3000 (el nombre MagicDNS o la IP 100.x).
FASTGRAM_APP_ORIGIN=http://localhost:3000

# ── Postgres ──────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 24   (hex: va dentro de una URL sin escapar)
POSTGRES_PASSWORD=

# ── Objetos (S3) ──────────────────────────────────────────────────────────
# Con el perfil `minio`: usuario raíz de MinIO (sólo lo usa `minio-init`).
MINIO_ROOT_USER=fastgram-admin
# Generar con: openssl rand -hex 24
MINIO_ROOT_PASSWORD=

# Nombre con el que el NAVEGADOR y los CONTENEDORES llegan al bucket. Adentro
# de Compose es un alias de red del contenedor de MinIO; en tu computadora
# tiene que resolver al VPS (o a 127.0.0.1 con el túnel SSH): ver
# deploy/README.md §Acceso. Tiene que coincidir con el host de S3_ENDPOINT.
S3_HOSTNAME=fastgram-s3
# Puerto del host para MinIO. TIENE que ser el mismo que el de S3_ENDPOINT:
# las URLs de subida van firmadas con ese Host.
S3_HOST_PORT=9000

S3_ENDPOINT=http://fastgram-s3:9000
S3_REGION=auto
S3_BUCKET=fastgram
# Usuario de la app (lo crea `minio-init` con la política readwrite).
S3_ACCESS_KEY_ID=fastgram-app
# Generar con: openssl rand -hex 24
S3_SECRET_ACCESS_KEY=
# Base pública de los objetos: es la URL canónica que se guarda en la base y
# la que baja el render. Con MinIO: <S3_ENDPOINT>/<S3_BUCKET>.
S3_PUBLIC_URL=http://fastgram-s3:9000/fastgram
# true para MinIO y para el endpoint de cuenta de R2. false sólo para AWS S3
# con el bucket en el host.
S3_FORCE_PATH_STYLE=true
# S3 externo (Cloudflare R2, etc.) en vez de MinIO: sacá `minio` de
# COMPOSE_PROFILES y poné acá su endpoint, bucket y credenciales. El bucket
# necesita lectura pública (el render baja por URL sin firmar, ESTADO §8) y
# CORS para PUT desde el origin de la web. Ninguna de las dos cosas está
# probada con R2 (P1-INFRA-004).

# ── Render ────────────────────────────────────────────────────────────────
# Vacío (recomendado): `init` genera uno la primera vez y lo guarda en el
# volumen `secrets`; render y worker lo leen de ahí. Si lo ponés acá (mínimo
# 32 caracteres, `openssl rand -base64 32`), gana este.
RENDER_MEDIA_GRANT_SECRET=

# ── LLM (opcional; también se configura desde /settings/models) ───────────
# Las keys que cargues desde la web viven en el volumen `fastgram-home`
# (models.json), no acá. Estas cuatro van juntas o ninguna.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_CONTEXT_WINDOW_TOKENS=

# ── Análisis de marca (worker) ────────────────────────────────────────────
# Vacías = los mismos defaults que `pnpm start` (límites de higiene, no cuotas).
BRAND_WEBSITE_TIMEOUT_MS=
BRAND_WEBSITE_MAX_BODY_BYTES=
BRAND_WEBSITE_MAX_REDIRECTS=
BRAND_WEBSITE_MAX_SECONDARY_PAGES=
BRAND_WEBSITE_MAX_TEXT_CHARS=
BRAND_WEBSITE_USER_AGENT=
BRAND_WEBSITE_ALLOWED_PORTS=
BRAND_SNAPSHOT_RAW_RETENTION_DAYS=

# ── Publicación (worker; todas opcionales, ver .env.example de la raíz) ────
PUBLISH_INSTAGRAM_GRAPH_HOST=
PUBLISH_META_GRAPH_VERSION=
PUBLISH_THREADS_API_VERSION=
PUBLISH_X_ALLOW_LINKS=

# ── Túnel (perfil `tunnel`, PU-RUN-005 · D-17) ────────────────────────────
# El hostname público del named tunnel, https y sin ruta
# (p. ej. https://fg.tu-dominio.com). Vacío = publicar por URL apagado.
FASTGRAM_PUBLIC_URL=
# Token del named tunnel (dashboard de Cloudflare → Tunnels → tu túnel).
# SECRETO: sólo lo recibe el contenedor `cloudflared`.
TUNNEL_TOKEN=

# ── Backups (deploy/backup/backup.sh, PU-RUN-006) ─────────────────────────
# Directorio del VPS donde quedan los backups. Fuera del repo.
BACKUP_DIR=/var/backups/fastgram
# Retención: cuántos diarios y cuántos semanales (domingo) se guardan.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Copia fuera del VPS (opcional): destino `mc` con el formato de alias por
# entorno de MinIO: https://<access>:<secret>@<host>  y el bucket/prefijo.
# Vacío = sólo copia local (un backup en el mismo disco NO protege de perder el VPS).
BACKUP_OFFSITE_URL=
BACKUP_OFFSITE_PATH=
