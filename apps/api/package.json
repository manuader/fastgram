{
  "name": "@fastgram/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@fastgram/adapters": "workspace:*",
    "@fastgram/config": "workspace:*",
    "@fastgram/contracts": "workspace:*",
    "@fastgram/core": "workspace:*",
    "@fastgram/db": "workspace:*",
    "@fastgram/ports": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "@fastify/swagger": "^9.4.0",
    "pino": "^9.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fastgram/config": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
