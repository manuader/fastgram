// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`compileReel > fija el HTML de un spec (snapshot) 1`] = `
"<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=1080, height=1920"/><title>FastGram reel</title><style>
html,body{width:1080px;height:1920px;overflow:hidden}
html,body{margin:0;padding:0;background:#000}
#root{position:relative;width:100%;height:100%;overflow:hidden}
.layer{position:absolute;left:0;top:0;width:100%;height:100%}
.vwrap{position:absolute;overflow:hidden}
.fill-media{position:absolute;left:0;top:0;width:100%;height:100%}
.bgin{position:absolute;left:0;top:0;width:100%;height:100%;overflow:hidden}
.bgimg{position:absolute;left:0;top:0;width:100%;height:100%;object-fit:cover;display:block}
.mbox{position:absolute}
.min{width:100%;height:100%}
.min img{width:100%;height:100%;display:block}
.tbox{position:absolute;transform:translateY(-50%);text-align:center;line-height:1.15;paint-order:stroke fill;overflow-wrap:break-word}
.tin{display:block}
.tline{white-space:pre-line;-webkit-box-decoration-break:clone;box-decoration-break:clone}
.w{display:inline-block}
.cbox{position:absolute;left:5%;width:90%;transform:translateY(-50%);text-align:center;line-height:1.1;paint-order:stroke fill}
.cin{display:inline-block}
.cw{display:inline-block;margin:0 0.1em}
.fx-flash{background:#fff}
@font-face{font-family:"fg-anton";src:url("fonts/anton-400.ttf") format("truetype");font-weight:400;font-style:normal;font-display:block}
@font-face{font-family:"fg-montserrat";src:url("https://cdn.example/f.ttf?sig=a&exp=1") format("truetype");font-weight:700;font-style:normal;font-display:block}
</style></head><body>
<div id="root" data-composition-id="fastgram-reel" data-no-timeline data-start="0" data-width="1080" data-height="1920" data-duration="15" data-fps="30" style="background:#111111">
<div id="L-bg" class="clip layer" data-start="0" data-duration="8.5" data-track-index="0" style="z-index:0"><div class="bgin"><img class="bgimg" src="assets/bg.jpg" alt=""/></div></div><div id="L-bg2" class="clip layer" data-start="8" data-duration="7" data-track-index="1" style="z-index:1"><div class="bgin" style="background:linear-gradient(160deg,#1D2B64,#F8CDDA)"></div></div><div id="L-clip" class="vwrap" style="left:0px;top:768px;width:1080px;height:1152px;z-index:5"><video id="L-clip-v0" src="assets/clip.keyed.webm" data-start="1" data-duration="4" data-track-index="2" data-media-start="0" muted playsinline class="fill-media" style="object-fit:contain"></video><video id="L-clip-v1" src="assets/clip.keyed.webm" data-start="5" data-duration="4" data-track-index="3" data-media-start="0" muted playsinline class="fill-media" style="object-fit:contain"></video><video id="L-clip-v2" src="assets/clip.keyed.webm" data-start="9" data-duration="2" data-track-index="4" data-media-start="0" muted playsinline class="fill-media" style="object-fit:contain"></video></div><div id="L-hook" class="clip layer" data-start="0.5" data-duration="3.5" data-track-index="5" style="z-index:10"><div class="tbox" style="left:54px;top:384px;width:972px;font-family:'fg-anton';font-weight:400;font-size:120px;color:#FFFFFF;-webkit-text-stroke:18px #000000"><div class="tin"><span class="tline"><span class="w" id="L-hook-w0">Stop</span> <span class="w" id="L-hook-w1">scrolling</span></span></div></div></div><div id="L-sweep" class="clip layer" data-start="4" data-duration="4" data-track-index="6" style="z-index:10"><div class="tbox" style="left:108px;top:307.2px;width:864px;font-family:'fg-montserrat';font-weight:700;font-size:78px;color:#111111;line-height:1.6"><div class="tin"><span class="tline" style="background-color:rgba(0,0,0,0.5);padding:9px 27px;border-radius:27px;background-image:linear-gradient(#FFE14D,#FFE14D);background-repeat:no-repeat;background-size:100% 100%;padding:0 14px">Reels that &lt;look&gt; good &amp; "fast"</span></div></div></div><div id="L-subs-k0" class="clip layer" data-start="1" data-duration="1.5" data-track-index="7" style="z-index:20"><div class="cbox" style="top:80%;font-family:'fg-montserrat';font-weight:700;font-size:90px;color:#FFFFFF;text-transform:uppercase;-webkit-text-stroke:18px #000000"><div class="cin"><span class="cw" id="L-subs-k0-w0">Stop</span> <span class="cw" id="L-subs-k0-w1">scrolling.</span></div></div></div><div id="L-subs-k1" class="clip layer" data-start="2.5" data-duration="1" data-track-index="8" style="z-index:20"><div class="cbox" style="top:80%;font-family:'fg-montserrat';font-weight:700;font-size:90px;color:#FFFFFF;text-transform:uppercase;-webkit-text-stroke:18px #000000"><div class="cin"><span class="cw" id="L-subs-k1-w0">This</span> <span class="cw" id="L-subs-k1-w1">is</span> <span class="cw" id="L-subs-k1-w2">it</span></div></div></div><audio id="A-clip-0" src="assets/clip.mp4" data-start="1" data-duration="4" data-track-index="9" data-media-start="0" data-volume="1"></audio><audio id="A-clip-1" src="assets/clip.mp4" data-start="5" data-duration="4" data-track-index="10" data-media-start="0" data-volume="1"></audio><audio id="A-clip-2" src="assets/clip.mp4" data-start="9" data-duration="2" data-track-index="11" data-media-start="0" data-volume="1"></audio><audio id="A-music-0" src="assets/music.mp3" data-start="0" data-duration="15" data-track-index="12" data-media-start="0" data-volume="1" data-automation='{"version":1,"lanes":[{"target":"volume","points":[{"t":0,"v":0},{"t":0.75,"v":0.45},{"t":1,"v":0.18},{"t":11,"v":0.18},{"t":11.25,"v":0.6},{"t":13.5,"v":0.6},{"t":15,"v":0}]}]}'></audio>
</div>
<script type="application/json" id="fg-motion">[{"s":"#L-bg .bgimg","k":[{"transform":"scale(1)"},{"transform":"scale(1.12)"}],"t":0,"d":8500,"e":"linear","f":"both"},{"s":"#L-bg2 .bgin","k":[{"opacity":0},{"opacity":1}],"t":8000,"d":500,"e":"linear","f":"both"},{"s":"#L-hook-w0","k":[{"opacity":0,"transform":"translateY(-120%) scale(1.25)","offset":0},{"opacity":1,"transform":"translateY(0%) scale(0.94)","offset":0.55},{"opacity":1,"transform":"translateY(-14%) scale(1.03)","offset":0.78},{"opacity":1,"transform":"translateY(0%) scale(1)","offset":1}],"t":500,"d":600,"e":"cubic-bezier(0.33,1,0.68,1)","f":"both"},{"s":"#L-hook-w1","k":[{"opacity":0,"transform":"translateY(-120%) scale(1.25)","offset":0},{"opacity":1,"transform":"translateY(0%) scale(0.94)","offset":0.55},{"opacity":1,"transform":"translateY(-14%) scale(1.03)","offset":0.78},{"opacity":1,"transform":"translateY(0%) scale(1)","offset":1}],"t":620,"d":600,"e":"cubic-bezier(0.33,1,0.68,1)","f":"both"},{"s":"#L-hook .tbox","k":[{"opacity":1},{"opacity":0}],"t":3717,"d":250,"e":"linear","f":"forwards"},{"s":"#L-sweep .tin","k":[{"opacity":0},{"opacity":1}],"t":4000,"d":150,"e":"linear","f":"both"},{"s":"#L-sweep .tin .tline","k":[{"backgroundSize":"0% 100%"},{"backgroundSize":"100% 100%"}],"t":4100,"d":600,"e":"cubic-bezier(0.65,0,0.35,1)","f":"both"},{"s":"#L-subs-k0 .cin","k":[{"opacity":0,"transform":"scale(0.85)"},{"opacity":1,"transform":"scale(1)"}],"t":1000,"d":120,"e":"cubic-bezier(0.22,1,0.36,1)","f":"both"},{"s":"#L-subs-k0-w0","k":[{"color":"#FFE14D","transform":"scale(1.14)","offset":0},{"color":"#FFE14D","transform":"scale(1)","offset":0.35},{"color":"#FFE14D","transform":"scale(1)","offset":1}],"t":1000,"d":400,"e":"linear","f":"none"},{"s":"#L-subs-k0-w1","k":[{"color":"#FFE14D","transform":"scale(1.14)","offset":0},{"color":"#FFE14D","transform":"scale(1)","offset":0.35},{"color":"#FFE14D","transform":"scale(1)","offset":1}],"t":1400,"d":1000,"e":"linear","f":"none"},{"s":"#L-subs-k1 .cin","k":[{"opacity":0,"transform":"scale(0.85)"},{"opacity":1,"transform":"scale(1)"}],"t":2500,"d":120,"e":"cubic-bezier(0.22,1,0.36,1)","f":"both"},{"s":"#L-subs-k1-w0","k":[{"color":"#FFE14D","transform":"scale(1.14)","offset":0},{"color":"#FFE14D","transform":"scale(1)","offset":0.35},{"color":"#FFE14D","transform":"scale(1)","offset":1}],"t":2500,"d":200,"e":"linear","f":"none"},{"s":"#L-subs-k1-w1","k":[{"color":"#FFE14D","transform":"scale(1.14)","offset":0},{"color":"#FFE14D","transform":"scale(1)","offset":0.35},{"color":"#FFE14D","transform":"scale(1)","offset":1}],"t":2700,"d":200,"e":"linear","f":"none"},{"s":"#L-subs-k1-w2","k":[{"color":"#FFE14D","transform":"scale(1.14)","offset":0},{"color":"#FFE14D","transform":"scale(1)","offset":0.35},{"color":"#FFE14D","transform":"scale(1)","offset":1}],"t":2900,"d":300,"e":"linear","f":"none"}]</script>
<script>(function(){var M=JSON.parse(document.getElementById('fg-motion').textContent);for(var i=0;i<M.length;i++){var m=M[i];var els=document.querySelectorAll(m.s);for(var j=0;j<els.length;j++){els[j].animate(m.k,{duration:m.d,delay:m.t,easing:m.e,fill:m.f,iterations:1}).pause();}}})();</script>
</body></html>
"
`;
