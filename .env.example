# ──────────────────────────────────────────────────────────────────────────
# FastGram — variables de entorno
#
# Copiá a `.env` y completá. Si falta una requerida, el proceso NO arranca
# (P0-REPO-009). Preferimos un crash al arrancar antes que un 500 a las tres
# horas en la única ruta que usa la variable.
# ──────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── Postgres ──────────────────────────────────────────────────────────────
# Con `docker compose up` esto ya funciona tal cual.
DATABASE_URL=postgres://fastgram:fastgram@localhost:5432/fastgram

# ── Objetos (S3) ──────────────────────────────────────────────────────────
# En desarrollo apunta a MinIO. En producción, a Cloudflare R2 (ADR-006).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=fastgram-dev
S3_ACCESS_KEY_ID=fastgram
S3_SECRET_ACCESS_KEY=fastgram-dev-secret
S3_PUBLIC_URL=http://localhost:9000/fastgram-dev

# ── API ───────────────────────────────────────────────────────────────────
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000

# ── Sesiones ──────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# ── Servicios internos ────────────────────────────────────────────────────
RENDER_SERVICE_URL=http://localhost:3002
VISION_SERVICE_URL=http://localhost:8000

# ── LLM (ADR-009) ─────────────────────────────────────────────────────────
# Gateway OpenAI-compatible. El modelo concreto se decide en P1-INFRA-001;
# no lo fijamos acá porque la relación precio/calidad cambia mes a mes.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Judgment (EXT-008 · ADR del puerto) ───────────────────────────────────
# Adaptador por defecto: `llm`. `typesafe` queda detrás de bandera por workspace.
JUDGMENT_ADAPTER=llm
TYPESAFE_API_KEY=
