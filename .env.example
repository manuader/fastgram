# ──────────────────────────────────────────────────────────────────────────
# FastGram — variables de entorno
#
# Copiá a `.env` y completá. Si falta una requerida, el proceso NO arranca
# (P0-REPO-009). Preferimos un crash al arrancar antes que un 500 a las tres
# horas en la única ruta que usa la variable.
# ──────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── Postgres ──────────────────────────────────────────────────────────────
# Con `docker compose up` esto ya funciona tal cual.
DATABASE_URL=postgres://fastgram:fastgram@localhost:5432/fastgram

# ── Objetos (S3) ──────────────────────────────────────────────────────────
# En desarrollo apunta a MinIO. En producción, a Cloudflare R2 (ADR-006).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=fastgram-dev
S3_ACCESS_KEY_ID=fastgram
S3_SECRET_ACCESS_KEY=fastgram-dev-secret
S3_PUBLIC_URL=http://localhost:9000/fastgram-dev

# ── API ───────────────────────────────────────────────────────────────────
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000

# ── apps/web ──────────────────────────────────────────────────────────────
# Ninguna de estas estaba documentada acá, y el navegador **no habla con
# `apps/api`**: habla con route handlers de la propia app de Next, que leen
# estas variables del servidor y reenvían. Son del servidor: no llevan
# `NEXT_PUBLIC_`, y no deben llevarlo.
FASTGRAM_API_URL=http://localhost:3001

# **PROVISORIO, y conviene saber qué implica.** Es UNA key por despliegue, o sea
# **un workspace para todo el que abra la app**. Además, todos los límites por
# workspace —por ejemplo los 3/min de `PATCH /blitz/preferences`— se comparten
# entre todos los usuarios a la vez. Lo que corresponde es `P1-AUTH-*`.
# Las 4 keys de la base están hasheadas: para desarrollo hay que sembrar una
# (ver `scripts/smoke-binary.mjs`, que crea una de un solo uso).
FASTGRAM_API_KEY=

# `apps/api` monta `/health` en la raíz, **fuera de `/api/v1`**, así que derivarlo
# del origen de `FASTGRAM_API_URL` falla detrás de un proxy con prefijo de ruta.
# Sin esta variable se deriva el origen, y sin nada, `http://localhost:3001/health`
# — correcto en desarrollo e **incorrecto** en cualquier despliegue con prefijo.
FASTGRAM_HEALTH_URL=

# ── Sesiones ──────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# ── Servicios internos ────────────────────────────────────────────────────
RENDER_SERVICE_URL=http://localhost:3002
VISION_SERVICE_URL=http://localhost:8000

# ── services/render (ADR-007) ─────────────────────────────────────────────
# Lo lee el PROCESO del render, no la API ni el worker. Ninguna de estas
# estaba acá y el servicio lee catorce: hasta ahora había que abrir
# `services/render/src/config.ts` para saber que existían.
#
# No hay servicio de render en `docker-compose.yml` a propósito: necesitaría
# un Dockerfile con FFmpeg, y qué componentes lleva ese FFmpeg (GPL vs LGPL)
# es `P0-REPO-004`, que está BLOQUEADA esperando una decisión legal. Mientras
# tanto se corre a mano: `pnpm --filter @fastgram/render-service dev`.
RENDER_PORT=3002

# Las 12 familias de `FR-051` se cargan de acá, con el nombre exacto
# `<familia>-<peso>.ttf`. **Sin esta variable no se renderiza NADA**: sin
# directorio el cargador marca toda fuente como no disponible y, con
# RENDER_FONT_STRICT=true, cada build muere con `font_unavailable`.
# Hoy no hay ni un archivo de fuente en el repo. De los 42 que hacen falta,
# 32 son de 10 familias con licencia OFL y se pueden bajar; los 10 de
# `tiktok` y `snapchat` esperan una decisión de licencia (`P2-RENDER-008`).
RENDER_FONT_DIR=
# `false` degrada a la fuente por defecto del sistema en vez de fallar. Útil
# para levantar el servicio sin fuentes; NO para producción, porque la pieza
# sale con otra tipografía y el aviso se pierde en un cache hit.
RENDER_FONT_STRICT=true

# Autorización de la media (NFR-006). El servicio no tiene base y no puede
# saber de qué workspace es una URL: se lo dice quien sí sabe.
#   - El grant firmado es lo ÚNICO que distingue un workspace de otro.
#   - Los prefijos son un piso global: se aplican a todos por igual.
# Con las dos cosas presentes se aplica la INTERSECCIÓN, no la unión.
# Generar con: openssl rand -base64 32   (mínimo 32 caracteres)
RENDER_MEDIA_GRANT_SECRET=
# `true` (default): sin grant firmado no se renderiza. Es la denegación por
# defecto que pide FR-070. Bajarlo a `false` deja el aislamiento por
# workspace apoyado sólo en los prefijos, que son iguales para todos.
RENDER_REQUIRE_GRANT=true
# CSV de prefijos (origen + ruta). El audio SÓLO puede venir de los
# compartidos. Hoy no hay ninguna pista en el repo de dónde vive la librería
# compartida: hasta que se decida, un build con audio se rechaza.
RENDER_ALLOWED_MEDIA_PREFIXES=
RENDER_SHARED_LIBRARY_PREFIXES=

# La cache es LOCAL al proceso y no tiene TTL ni desalojo. Con varias
# réplicas y sin volumen compartido, el `POST /render` se resuelve en una y
# el `GET` del href puede caer en otra que no tiene el archivo: ahí el 404 es
# correcto. O el directorio es un volumen compartido, o hay una sola réplica.
RENDER_CACHE_DIR=
RENDER_NORMALIZE_INPUTS=true
# `false` (default): un HDR que no se pudo tone-mapear se rechaza en vez de
# salir lavado. Este FFmpeg no trae `zscale` ni `libplacebo`, así que hoy
# falla cerrado (`P2-RENDER-013`).
RENDER_ALLOW_UNTONEMAPPED_HDR=false

# NFR-013. Bytes.
RENDER_MAX_IMAGE_BYTES=10485760
RENDER_MAX_VIDEO_BYTES=52428800
RENDER_MAX_AUDIO_BYTES=52428800
RENDER_DOWNLOAD_TIMEOUT_MS=30000

# ── LLM (ADR-009) ─────────────────────────────────────────────────────────
# Gateway OpenAI-compatible. El modelo concreto se decide en P1-INFRA-001;
# no lo fijamos acá porque la relación precio/calidad cambia mes a mes.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Judgment (EXT-008 · ADR del puerto) ───────────────────────────────────
# Adaptador por defecto: `llm`. `typesafe` queda detrás de bandera por workspace.
JUDGMENT_ADAPTER=llm
TYPESAFE_API_KEY=
