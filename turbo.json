{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false,
      // Turbo NO propaga variables arbitrarias a las tareas. Sin esta lista,
      // la suite de MinIO de `apps/api` se **saltea sola** en `pnpm test:int`
      // —y por lo tanto también en CI— diciendo el motivo en el nombre del
      // describe, que es lo correcto pero pasa desapercibido entre 137 casos.
      //
      // `DATABASE_URL` parecía funcionar, y funcionaba por casualidad: los
      // fixtures tienen un default hardcodeado al Postgres del compose. Las
      // `S3_*` no tienen default, y no pueden tenerlo.
      "passThroughEnv": [
        "DATABASE_URL",
        "S3_ENDPOINT",
        "S3_REGION",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_PUBLIC_URL",
        "S3_FORCE_PATH_STYLE"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
